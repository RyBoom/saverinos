{
  // Never add "routes" or "custom_domain" here. The private hostname is attached
  // in Cloudflare, not in this repo, on purpose. Wrangler would override that
  // route on the next deploy, and a Custom Domain would publish the name.
  "name": "savarinos-market",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./site" },
  "workers_dev": false,
  "preview_urls": false
}
